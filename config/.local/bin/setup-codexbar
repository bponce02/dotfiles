#!/usr/bin/env bash
set -euo pipefail

PROVIDER_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/codexbar/providers"

if ! command -v codexbar &>/dev/null; then
    echo "setup-codexbar: codexbar is not installed" >&2
    exit 1
fi

if [[ ! -f "$PROVIDER_FILE" ]]; then
    echo "setup-codexbar: provider list not found at $PROVIDER_FILE" >&2
    exit 1
fi

while IFS= read -r provider; do
    [[ -n "$provider" && "$provider" != \#* ]] || continue
    codexbar config enable --provider "$provider"
done < "$PROVIDER_FILE"

# Credentials are deliberately not stored in dotfiles. Use the environment
# variable when supplied; otherwise ask for the key when running interactively.
openrouter_key="${OPENROUTER_API_KEY:-}"
if grep -qx openrouter "$PROVIDER_FILE"; then
    if [[ -z "$openrouter_key" && -t 0 ]]; then
        read -rsp "OpenRouter API key (leave blank to skip): " openrouter_key
        echo
    fi

    if [[ -n "$openrouter_key" ]]; then
        printf '%s' "$openrouter_key" |
            codexbar config set-api-key --provider openrouter --stdin
    else
        echo "OpenRouter key not configured. Set OPENROUTER_API_KEY and rerun setup-codexbar."
    fi
fi
unset openrouter_key

echo "CodexBar providers configured."

# Restart a running Noctalia instance so the bar and its CodexBar plugin pick
# up the new provider configuration immediately. Do not start it from a TTY
# where a graphical session may not be available.
if command -v noctalia &>/dev/null && pgrep -x noctalia &>/dev/null; then
    pkill -x noctalia
    for _ in {1..50}; do
        pgrep -x noctalia &>/dev/null || break
        sleep 0.1
    done
    noctalia --daemon
    echo "Noctalia bar restarted."
fi
