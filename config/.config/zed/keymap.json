[
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space a a": ["task::Spawn", { "task_name": "pi: ask about selection", "reveal_target": "center" }],
      "space a l": ["task::Spawn", { "task_name": "pi: review questions", "reveal_target": "center" }],
      "space a s": ["task::Spawn", { "task_name": "pi: send questions", "reveal_target": "center" }]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-w": ["pane::CloseActiveItem", { "close_pinned": false }]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space p": "projects::OpenRecent",
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space e": "project_panel::ToggleFocus",
      "space g g": ["task::Spawn", { "task_name": "git: lazygit", "reveal_target": "center" }],
      "ctrl-s": "workspace::Save",
      "space g s": "editor::ToggleSplitDiff",
      "space t t": "workspace::NewCenterTerminal",
      "space g v": "git::Diff",
      "space g shift-v": "git::OpenFileDiff"
    }
  },
  {
    "context": "Editor && (vim_mode == insert || vim_mode == visual || vim_mode == replace)",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space p": "projects::OpenRecent",
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space e": "project_panel::ToggleFocus",
      "space g g": ["task::Spawn", { "task_name": "git: lazygit", "reveal_target": "center" }],
      "space t t": "workspace::NewCenterTerminal",
      "space g v": "git::Diff",
      "space g shift-v": "git::OpenFileDiff"
    }
  }
]
