// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "ctrl-alt-p": ["task::Spawn", { "task_name": "git: stage, commit, push" }]
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-s": "workspace::Save"
    },
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "ctrl-j": "editor::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "space e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "ctrl-/": "terminal_panel::Toggle"
    }
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "space g g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "space g p": ["task::Spawn", { "task_name": "git: stage, commit, push" }]
    }
  },
  {
    "context": "vim_mode == normal",
      "bindings": {
      "ctrl-enter": "agent::ToggleFocus"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "ctrl-shift-enter": "assistant::InlineAssist"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist"
    }
  }
]
